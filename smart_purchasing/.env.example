# Hugging Face Access Token (Free Read Token)
# Get yours in 30 seconds at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Optional: Model to query on Hugging Face Serverless Inference API
# Defaults to Qwen/Qwen2.5-72B-Instruct for maximum reasoning quality
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
