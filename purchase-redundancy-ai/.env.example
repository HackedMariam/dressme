# Purchase Redundancy Detection - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# ENVIRONMENT
# ============================================================================

DEBUG=False
ENVIRONMENT=development

# ============================================================================
# CLAUDE API
# ============================================================================

# Your Anthropic API key - Get from https://console.anthropic.com
CLAUDE_API_KEY=your-api-key-here

# Model and effort (low | medium | high | xhigh | max)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_AGENT_EFFORT=medium

# Set to False to never call an LLM (rule-based explanations only)
LLM_ENABLED=True

# ============================================================================
# OPENAI (GPT)
# ============================================================================

# Which LLM drives explanations and the agent: openai | claude | auto (OpenAI when OPENAI_API_KEY is set)
LLM_PROVIDER=auto
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4.1

# ============================================================================
# CATALOG
# ============================================================================

# real = database/products_real.json (scraped photos, see database/scrape_real_catalog.py)
# illustrated = database/products_700.json (generated illustrations). Default: real when the file exists.
# CATALOG=real

# ============================================================================
# DATABASE
# ============================================================================

# Default: SQLite file data/redundancy.db. For PostgreSQL either set DATABASE_URL (wins) ...
# DATABASE_URL=postgresql://redundancy:your_password@localhost:5433/purchase_redundancy
# Supabase (dedicated role and schema, session pooler on port 5432 - see README section 8):
# DATABASE_URL=postgresql://dressme_ai.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ... or DB_TYPE=postgresql with the DB_* values below. docker-compose.yml starts one on port 5433.
DB_TYPE=sqlite
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# PostgreSQL configuration (only if DB_TYPE=postgresql and no DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=purchase_redundancy

# ============================================================================
# CACHE (Redis) - optional
# ============================================================================

# Shared cache (CLIP text embeddings, catalog searches) and rate-limit counters.
# Empty or unreachable -> in-memory cache (fine for a single API process).
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# ============================================================================
# ACCOUNTS (JWT)
# ============================================================================

# Signing key for login tokens. Empty -> generated once in data/.secret_key.
# Production: set a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_EXPIRE_HOURS=168
# False: visitors without an account share the guest wardrobe. True: an account is mandatory.
AUTH_REQUIRED=False

# ============================================================================
# RATE LIMITING (requests per minute and per client IP)
# ============================================================================

RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_HEAVY=30
RATE_LIMIT_AUTH=10
# Behind a reverse proxy, uvicorn trusts X-Forwarded-For only from these IPs (comma-separated)
# FORWARDED_ALLOW_IPS=127.0.0.1

# ============================================================================
# CLIP MODEL
# ============================================================================

# Set to False to skip loading CLIP (simulated embeddings, faster startup)
CLIP_ENABLED=True

# Use GPU if available
USE_CUDA=False

# int8 quantization: ~1.5-1.8x faster on CPU but measurably less accurate (see README) - keep False
CLIP_QUANTIZE=False

# ============================================================================
# API
# ============================================================================

API_PORT=8000
API_HOST=0.0.0.0

# CORS origins (comma-separated). The Vite dev server proxies /api, so CORS is
# only needed when calling the API directly from another origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
# text, or json (one object per line - for Loki / ELK / Datadog). Files rotate at 10 MB in logs/
LOG_FORMAT=text

# ============================================================================
# FRONTEND (read by Vite - put it in frontend/.env if you need it)
# ============================================================================

# VITE_API_URL=http://localhost:8000
# Serve catalog images from a CDN that mirrors /images/ (they are cached as immutable)
# VITE_CDN_URL=https://cdn.example.com
