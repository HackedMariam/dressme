# Leave empty to use the Vite dev proxy (/api -> BACKEND_URL or 127.0.0.1:8000).
# Set an absolute URL when the frontend is served without a reverse proxy.
VITE_API_URL=

# The avatar/body-scan service runs separately from the wardrobe API.
# Start it with: cd backend && uvicorn main:app --host 127.0.0.1 --port 8001
VITE_AVATAR_API_URL=http://127.0.0.1:8001

# Public Supabase configuration. Never add SUPABASE_SERVICE_ROLE_KEY here:
# this file is compiled into the browser bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
