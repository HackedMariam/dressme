# Leave empty to use the Vite dev proxy (/api -> BACKEND_URL or 127.0.0.1:8000).
# Set an absolute URL when the frontend is served without a reverse proxy.
VITE_API_URL=

# Help Me Pack service (separate from the wardrobe API).
VITE_TRIP_API_URL=http://localhost:8020

# Outfit Studio uses the BO4 proxy in development. In production proxy
# /api/stylist to BO4, or use a BO4 URL with CORS configured at the gateway.
VITE_STYLIST_API_URL=

# Public Supabase configuration. Never add SUPABASE_SERVICE_ROLE_KEY here:
# this file is compiled into the browser bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
