# DressMe UI (Vite) environment
# The RAG API runs on port 8000 by default. The Vite dev server runs on 8443.
VITE_API_URL=http://localhost:8000
# Must match RAG_API_KEY in the backend .env. This value is bundled into the
# browser build, so it is demo-level gating, not production security.
VITE_RAG_API_KEY=

# Optional: only needed if the UI talks to Supabase directly for wardrobe data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The API's CORS_ORIGINS must include the UI origin(s):
#   http://localhost:5173,http://localhost:8443
