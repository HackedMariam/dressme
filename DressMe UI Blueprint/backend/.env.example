# Copy to backend/.env and fill in your key. Any OpenAI-compatible endpoint works.

# OpenAI (default): https://platform.openai.com/api-keys
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Wardrobe from BO1 (Supabase `items`). Leave empty to use data/sample_wardrobe.json.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=   (Supabase dashboard > Project Settings > API > service_role; never commit it)
# WARDROBE_USER_ID=<auth user id whose pieces BO3 analyses>

# Groq alternative: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Gemini alternative: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
