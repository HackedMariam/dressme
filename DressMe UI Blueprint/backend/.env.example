# Copy to backend/.env and fill in your key. Any OpenAI-compatible endpoint works.

# OpenAI (default): https://platform.openai.com/api-keys
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# BO1 verifies the signed-in user's token and supplies that user's wardrobe.
# BO1_URL=http://127.0.0.1:8000

# Groq alternative: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Gemini alternative: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
