# --- LLM ---
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_SEND_IMAGE=true
LLM_IMAGE_DETAIL=low

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=

# --- RAG ingestion ---
# Leave blank to use paths resolved relative to rag_backend/.
RAG_PDF_DIR=
RAG_DATA_DIR=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=sentence-transformers/all-MiniLM-L6-v2-v1
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
OCR_ENABLED=true
OCR_MIN_CHARS=24
OCR_DPI=200
OCR_LANGUAGE=eng
# Optional: full path to tesseract.exe when it is not on PATH.
TESSERACT_CMD=
# Per-document extraction cache makes long OCR runs resumable.
RAG_EXTRACTION_CACHE_DIR=

# --- RAG retrieval / answers ---
RAG_TOP_K=5
RAG_CANDIDATE_K=30
RAG_MIN_SIMILARITY=0.25
RAG_HYBRID_ENABLED=true
RAG_RRF_CONSTANT=60
RAG_MAX_CONTEXT_CHARS=12000
QUERY_REWRITE_ENABLED=true

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
PUBLIC_API_URL=http://localhost:8000
# Shared secret you generate (e.g. openssl rand -hex 32). Leave blank to
# disable authentication for local development only.
RAG_API_KEY=
RAG_API_KEY_HEADER=X-API-Key
RAG_RATE_LIMIT_PER_MINUTE=30
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Model / detection (rest of the app) ---
MODEL_PATH=models/dressme_best.pt
DETECT_CONF=0.25
REVIEW_THRESHOLD=0.60
MAX_UPLOAD_MB=15
