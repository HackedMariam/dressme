# Root environment — used by the FastAPI backend and the Trip Agent.
# Copy to .env and fill in the values you need. Never commit .env.

# Required for LLM extraction, tool calling and explanations.
OPENAI_API_KEY=

# Chat model used by the Trip Agent.
LLM_MODEL=gpt-4o

# Extra comma-separated origins allowed by the API.
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# Optional overrides.
# TRIP_AGENT_USE_LLM=1
# TRIP_AGENT_ALLOW_WEATHER=1
# TRIP_AGENT_VERBOSE=0
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000
