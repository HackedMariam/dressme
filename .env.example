# ============================================================
# DRESSME : single .env at the repository root. Never commit it.
# Copy this file to .env and fill in the empty values.
# Every service reads it. A service's own .env (if it has one) is read first and wins.
# No inline comments after a value: some services use a minimal .env parser.
# ============================================================

# ---------- LLM (OpenAI) ----------
# One key for the whole project (BO1 and BO3 also accept LLM_API_KEY as an alias).
# Free alternative: Groq or Gemini (see below).
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_SEND_IMAGE=true
LLM_IMAGE_DETAIL=low
# Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=llama-3.3-70b-versatile
# Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash

# ---------- Supabase (secret, backend only) ----------
# Leave SUPABASE_SERVICE_ROLE_KEY empty to run in local single-user mode.
# BO3 also accepts SUPABASE_SERVICE_KEY as an alias. Never put this key in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=wardrobe
# User whose wardrobe BO3 and the shopping assistant read.
# Empty (with SUPABASE_SERVICE_ROLE_KEY empty) = sample data / local mode.
WARDROBE_USER_ID=

# ---------- Supabase (public, read by the browser and the orchestrator page) ----------
SUPABASE_ANON_KEY=

# ---------- Vision (BO1) ----------
MODEL_PATH=models/dressme_best.pt
DETECT_CONF=0.25
REVIEW_THRESHOLD=0.60
MAX_UPLOAD_MB=15

# ---------- HTTP / ports ----------
# BO1 8000, BO3 8001, Help Me Pack 8020, Purchase Redundancy 8040 (set by start_all.ps1), Stylist 8061, Orchestrator 8070
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=
VITE_TRIP_API_URL=http://localhost:8020

# ---------- Hugging Face (smart_purchasing, optional) ----------
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# ---------- purchase-redundancy-ai (optional) ----------
# Claude model for purchase-redundancy-ai only. LLM_MODEL above is shared with the OpenAI services.
# CLAUDE_MODEL=claude-opus-5-5
LLM_PROVIDER=auto
OPENAI_MODEL=gpt-4.1
LLM_ENABLED=True
DB_TYPE=sqlite
# DATABASE_URL=
SECRET_KEY=
AUTH_REQUIRED=False
CLIP_ENABLED=True
USE_CUDA=False
LOG_LEVEL=INFO

# ---------- 3D avatar and virtual try-on (fal.ai, https://fal.ai/dashboard/keys) ----------
# One key, pay per use (add credit in the fal.ai billing page). Server only: never in the frontend.
FAL_KEY=
# FAL_3D_MODEL=fal-ai/hunyuan3d/v2
# FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.6
# AVATAR_CREATIONS_PER_DAY=3
# AVATAR_TRYONS_PER_HOUR=10

# ---------- BO5 RAG (rag_backend/) ----------
# Port 8000 is BO1; run the RAG API on 8010: uvicorn app:app --port 8010 (from rag_backend/)
# Reuses OPENAI_API_KEY / LLM_MODEL / SUPABASE_* above. Apply supabase/migrations/*knowledge_chunks* and *rag_security* first.
RAG_PDF_DIR=
RAG_DATA_DIR=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=sentence-transformers/all-MiniLM-L6-v2-v1
RAG_TOP_K=5
RAG_CANDIDATE_K=30
RAG_MIN_SIMILARITY=0.25
RAG_HYBRID_ENABLED=true
QUERY_REWRITE_ENABLED=true
RAG_API_KEY=
RAG_API_KEY_HEADER=X-API-Key
RAG_RATE_LIMIT_PER_MINUTE=30

# ---------- 3D avatar and virtual try-on provider ----------
# WaveSpeed is cheaper than fal.ai (avatar about $0.30, try-on about $0.04). With AVATAR_PROVIDER=auto it is used
# as soon as WAVESPEED_API_KEY is set; otherwise fal.ai (FAL_KEY) is used. Restart BO1 after changing these.
AVATAR_PROVIDER=auto
WAVESPEED_API_KEY=

# AI Stylist knowledge base (rag_backend/): the stylist calls it as a tool. RAG_TABLE picks the corpus.
RAG_URL=http://127.0.0.1:8010
RAG_TABLE=knowledge_chunks_v2
