# Copy to .env (at the project root) and fill in.

# --- LLM : OpenAI GPT-4 (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o                  # GPT-4 family with vision: gpt-4o, gpt-4.1, gpt-4o-mini (cheaper)
LLM_SEND_IMAGE=true               # GPT-4 also looks at the cut-out, not only the model output
LLM_IMAGE_DETAIL=low              # low = cheap & fast, high = better on fine patterns/materials

# --- Supabase: Dashboard > Project Settings > API ---
# Leave empty to run in local single-user mode (data in backend/local_data, no login).
# When set, users must sign in and each user only sees their own wardrobe.
SUPABASE_URL=https://gxmvxegwlntqpcardrjq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # server only, never put it in the frontend
SUPABASE_BUCKET=wardrobe

# --- Vision model ---
MODEL_PATH=models/dressme_best.pt
DETECT_CONF=0.25
REVIEW_THRESHOLD=0.60             # below this confidence the item is flagged "Needs review"

# --- Optional: Hugging Face image-to-3D for wardrobe items ---
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=
# cutout-2.5d is fast and offline. Set to hunyuan3d to use the official
# Tencent/Hunyuan3D-2.1 Space (about 1-2 minutes per item).
ITEM_MESH_PROVIDER=cutout-2.5d
HF_3D_SPACE=tencent/Hunyuan3D-2.1
HF_3D_API_NAME=/generation_all
HF_3D_TIMEOUT_SECONDS=900
HF_3D_STEPS=30
HF_3D_OCTREE_RESOLUTION=256
# Maximum polygon count stored for each generated item mesh.
ITEM_MESH_TARGET_FACES=30000

# --- HTTP ---
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:8000
MAX_UPLOAD_MB=15
